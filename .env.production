# Where this build is SERVED. The real domain since the cutover (2026-11-04);
# dkk.beytrax.com is now a permanent redirect here.
VITE_PUBLIC_SITE_URL=https://dietrich-klinghardt.com

# The domain the CMS knows this site by — used only to resolve site-context.
# Empty since the cutover: the served domain and the `sites` row now match.
VITE_PUBLIC_CMS_SITE_DOMAIN=

# True since the cutover: this build serves the real domain, so pages are
# indexable and robots.txt publishes the sitemap.
VITE_PUBLIC_INDEXABLE=true
VITE_PUBLIC_API_URL=https://api.beytrax.com
VITE_PUBLIC_CMS_URL=https://portal.beytrax.com
VITE_PUBLIC_ENABLE_RUNTIME_CMS=true

VITE_PUBLIC_TENANT_ID=75cadacc-54f9-4fa6-926a-30fca7c4c20e
VITE_PUBLIC_SITE_ID=d333e78f-4023-4a3a-9720-e00a6d0df30f
VITE_PUBLIC_TENANT_KEY=dietrich-klinghardt-landing
VITE_PUBLIC_TENANT_NAME=Dietrich Klinghardt Landing

VITE_PUBLIC_CONTACT_URL=#newsletter
VITE_PUBLIC_VIMEO_URL=#newsletter
VITE_PUBLIC_INSTAGRAM_URL=#newsletter

# Beytrax's PLATFORM Stripe publishable key (pk_live_…). Donations are charged
# by the platform and attributed to the Foundation via Stripe Connect, so this
# is NOT the tenant's own key. Empty = the donate page says donations are not
# open yet instead of rendering a form that cannot charge.
VITE_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Client's MapTiler custom style (practitioner directory map). Public map
# key baked into the URL — not a server secret, safe to commit.
VITE_PUBLIC_MAPTILER_STYLE_URL=https://api.maptiler.com/maps/01a0acbf-0433-7e7b-bf3c-a53c95ea1f87/style.json?key=MrMbxcI1FBXveGt9KyhT
