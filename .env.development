# Local dev — points at the real CMS/API so `npm run dev` renders actual
# content instead of the code-level fallbacks. Same TENANT_ID/SITE_ID as
# .env.production (this site's real row), no secrets: every var here is
# VITE_PUBLIC_* and ships in the client bundle regardless of environment.
VITE_PUBLIC_SITE_URL=http://localhost:4325

VITE_PUBLIC_CMS_SITE_DOMAIN=dietrich-klinghardt.com

# Never indexable locally.
VITE_PUBLIC_INDEXABLE=false
VITE_PUBLIC_API_URL=https://api.beytrax.com
VITE_PUBLIC_CMS_URL=https://portal.beytrax.com
VITE_PUBLIC_ENABLE_RUNTIME_CMS=true

VITE_PUBLIC_TENANT_ID=75cadacc-54f9-4fa6-926a-30fca7c4c20e
VITE_PUBLIC_SITE_ID=d333e78f-4023-4a3a-9720-e00a6d0df30f
VITE_PUBLIC_TENANT_KEY=dietrich-klinghardt-landing
VITE_PUBLIC_TENANT_NAME=Dietrich Klinghardt Landing

VITE_PUBLIC_CONTACT_URL=#newsletter
VITE_PUBLIC_VIMEO_URL=#newsletter
VITE_PUBLIC_INSTAGRAM_URL=#newsletter

# Left empty, same as production — no test/publishable key configured here.
VITE_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Client's MapTiler custom style (practitioner directory map). Public map
# key baked into the URL — not a server secret, safe to commit.
VITE_PUBLIC_MAPTILER_STYLE_URL=https://api.maptiler.com/maps/01a0acbf-0433-7e7b-bf3c-a53c95ea1f87/style.json?key=MrMbxcI1FBXveGt9KyhT
