RewriteEngine On

# SPA fallback for ROUTES only.
#
# Without the extension guard below, every missing path returns index.html with
# HTTP 200 — including /sitemap.xml, which is exactly what a crawler asks for.
# A missing file must 404; only extension-less paths are client-side routes.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteRule . /index.html [L]

# A missing file must 404 — but today it does not, and this rule cannot fix it
# on its own.
#
# Plesk has Node.js hosting enabled on this domain (PassengerAppType node,
# PassengerStartupFile app.js) even though the site is fully static and there is
# no app.js. mod_passenger claims any request that does not resolve to a file
# *before* .htaccess rewrites run, so /sitemap.xml and every missing asset come
# back as "Web application could not be started" — HTTP 500, not 404.
#
# The rule below is kept because it is the right one: the moment Node.js hosting
# is switched off for the domain (see PENDIENTES B23), it starts producing the
# 404. Until then it is pre-empted. This is fleet-wide, not specific to this
# site — sistworldfoundation.org answers 500 the same way today.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . - [R=404,L]
