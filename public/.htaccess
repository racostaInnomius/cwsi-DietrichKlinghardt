RewriteEngine On

# mod_dir would 301 `/courses` to `/courses/` the moment it sees a directory of
# that name, and it does so *before* per-directory rewrites get a chance to run
# — so the rule below never fired until this was switched off. Nothing here
# wants directory URLs: every page is a file, and `courses/` only exists to hold
# `courses/art.html`.
DirectorySlash Off

# Clean URLs — and the reason this rule has to come first.
#
# The SSG emits a page and its children as siblings: `courses.html` *and* a
# `courses/` directory holding `courses/art.html`. So `/courses` names both a
# file and a directory. Left alone, mod_dir wins: it 301s to `/courses/`, which
# has no index and answers 403, and the page becomes unreachable. Resolving the
# `.html` first settles the ambiguity before mod_dir ever sees a directory.
#
# Matching on $1 rather than REQUEST_FILENAME so that `/courses/` — the URL
# mod_dir would have redirected to — resolves to the same page.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# SPA fallback for ROUTES only.
#
# Without the extension guard below, every missing path returns index.html with
# HTTP 200 — including /sitemap.xml, which is exactly what a crawler asks for.
# A missing file must 404; only extension-less paths are client-side routes.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteRule . /index.html [L]

# A missing file answers 404 here rather than being left to fall through.
#
# This only works because Node.js hosting is switched OFF for the domain. While
# it was on, Plesk pointed mod_passenger at an app root with no `app.js`, and
# Passenger claimed every request that did not resolve to a file — before
# .htaccess rewrites run — so missing files came back as "Web application could
# not be started", HTTP 500. If a 500 ever reappears here, check that setting
# first. It is still on for the sibling static sites (see PENDIENTES B23).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . - [R=404,L]
